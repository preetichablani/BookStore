<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        body {
            margin: 0;
            background: linear-gradient(135deg, #eef7ff, #d8ebfa, #c7e0f5);
        }
        .section-title {
            font-family: Georgia, serif;
        }
        .hero {
            background: linear-gradient(135deg, #123f63, #18577f, #236f9f);
        }
        .book-card {
            transition: all 0.3s ease;
        }
        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 30px rgba(18, 63, 99, 0.15);
        }
        .category-card {
            transition: all 0.3s ease;
        }
        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(18, 63, 99, 0.12);
        }
    </style>
</head>
<body>

<%- include('includes/nav.ejs') %>
<section class="max-w-6xl mx-auto px-5 pt-10">
    <div class="hero rounded-[30px]
                px-8 py-14 md:px-14
                flex flex-col md:flex-row
                items-center justify-between
                gap-10 text-white">
        <div class="max-w-2xl">
            <p class="uppercase tracking-[4px] text-sm text-blue-100 mb-4">Welcome to our bookstore </p>

            <h1 class="section-title
                       text-4xl md:text-6xl
                       font-bold leading-tight">

                Find a book
                <span class="text-blue-200"> worth reading.</span></h1>


            <p class="mt-6 text-blue-100
                      leading-7 text-base md:text-lg">
                Discover stories, ideas and books that make
                your reading time more interesting. Explore
                our collection and find something that feels
                right for you.
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
                <a href="/books"
                   class="px-7 py-3 rounded-xl
                          bg-white text-[#123f63]
                          font-semibold
                          hover:bg-blue-50 transition">
                    Explore Books
                    <i class="fa-solid fa-arrow-right ml-2"></i>
                </a>

                <a href="/category"
                   class="px-7 py-3 rounded-xl
                          border border-white/50
                          font-semibold
                          hover:bg-white/10 transition">
                    Browse Categories
                </a>
            </div>
        </div>


        <div class="w-full md:w-80">
            <div class="bg-white/10
                        border border-white/20
                        rounded-3xl p-7">
                <div class="bg-white
                            rounded-2xl
                            p-8 text-center
                            shadow-xl">
                    <i class="fa-solid fa-book-open
                              text-6xl text-[#18577f]"></i>

                    <p class="text-[#123f63]
                              uppercase
                              tracking-[3px]
                              text-xs font-bold mt-5">
                        Read • Discover • Grow
                    </p>

                    <div class="h-[2px]
                                w-12
                                bg-[#398bd5]
                                mx-auto mt-4">
                    </div>
                    <p class="text-slate-500
                              text-sm mt-4">
                        A collection made
                        for curious readers.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="max-w-6xl mx-auto px-5 py-14">
    <div class="text-center max-w-2xl mx-auto">
        <p class="text-[#236f9f]
                  font-semibold uppercase
                  tracking-widest text-sm"> A place for readers </p>

        <h2 class="section-title
                   text-3xl md:text-4xl
                   font-bold text-[#123f63] mt-2"> Books for every kind of reader</h2>

        <p class="text-slate-500
                  mt-4 leading-7">
            Whether you enjoy getting lost in a story,
            learning something useful or discovering
            the life of an inspiring person, our collection
            gives you different books to explore.
        </p>
    </div>


    <div class="grid grid-cols-1 md:grid-cols-3
                gap-6 mt-10">

        <div class="bg-white rounded-2xl
                    p-7 text-center shadow-sm">

            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">

                <i class="fa-solid fa-book"></i>
            </div>


            <h3 class="text-xl font-bold
                       text-[#123f63] mt-5">Stories</h3>


            <p class="text-slate-500
                      text-sm leading-6 mt-3">
                Fiction, fantasy and interesting
                stories for readers who love
                imagination.
            </p>
        </div>

        <div class="bg-white rounded-2xl
                    p-7 text-center shadow-sm">

            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">

                <i class="fa-solid fa-lightbulb"></i>
            </div>


            <h3 class="text-xl font-bold
                       text-[#123f63] mt-5">Learning</h3>

            <p class="text-slate-500
                      text-sm leading-6 mt-3">
                Books that introduce useful ideas,
                habits and new ways of thinking.
            </p>
        </div>

        <div class="bg-white rounded-2xl
                    p-7 text-center shadow-sm">
            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">
                <i class="fa-solid fa-user"></i>
            </div>

            <h3 class="text-xl font-bold
                       text-[#123f63] mt-5">Real Lives
            </h3>

            <p class="text-slate-500
                      text-sm leading-6 mt-3">

                Discover the experiences and
                journeys of interesting people.
            </p>
        </div>
    </div>
</section>


<section class="max-w-6xl mx-auto px-5 pb-16">
    <div class="flex flex-col md:flex-row
                md:items-end md:justify-between
                gap-4 mb-7">
        <div>

            <div class="flex items-center gap-2">
                <span class="w-7 h-[2px]
                             bg-[#398bd5]"></span>

                <p class="text-[#398bd5]
                          font-semibold
                          uppercase
                          tracking-[3px]
                          text-xs">
                    Recommended for you
                </p>
            </div>

            <h2 class="section-title
                       text-3xl md:text-4xl
                       font-bold
                       text-[#123f63] mt-2">
                Featured Books
            </h2>

            <p class="text-slate-500 mt-1"> A few picks from our collection.</p>
        </div>


        <a href="/books"
           class="inline-flex items-center
                  gap-2 text-[#18577f]
                  font-semibold text-sm
                  hover:text-[#398bd5]
                  transition">View All Books
            <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
    </div>

    <div class="grid grid-cols-1
                md:grid-cols-2
                lg:grid-cols-3
                gap-6
                items-start">

        <% books.forEach(book => { %>


        <div class="book-card bg-white
                    rounded-2xl
                    overflow-hidden
                    border border-slate-200
                    shadow-sm">

            <div class="relative h-56
                        bg-[#edf6fc]
                        flex items-center
                        justify-center">

                <button
                    class="absolute top-3 right-3
                           w-8 h-8
                           rounded-full
                           bg-white
                           shadow-sm
                           text-slate-400
                           hover:text-[#18577f]
                           transition">
                    <i class="fa-regular fa-bookmark text-sm"></i>
                </button>

                <img src="<%= book.img.startsWith('/') ? book.img : '/' + book.img %>"
                     alt="<%= book.title %>"
                     class="h-48 max-w-[72%]
                            object-contain
                            drop-shadow-lg">
            </div>

            <div class="p-5">
                <div class="flex items-center
                            justify-between">

                    <p class="text-[11px]
                              font-semibold
                              uppercase
                              tracking-[2px]
                              text-[#398bd5]">
                        <%= book.category %>
                    </p>

                    <div class="flex gap-1
                                text-[#e4a72c]
                                text-[10px]">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-regular fa-star"></i>
                    </div>
                </div>

                <h3 class="text-xl font-bold
                           text-[#123f63] mt-2">
                    <%= book.title %>
                </h3>

                <p class="text-slate-500
                          text-sm mt-1">
                    <%= book.author %>
                </p>

                <div class="border-t
                            border-slate-100
                            mt-4 pt-4
                            flex items-center
                            justify-between">
                    <div>
                        <p class="text-[11px]
                                  text-slate-400">Price</p>

                        <p class="text-lg
                                  font-bold
                                  text-[#18577f]">

                            ₹<%= book.price %>
                        </p>
                    </div>

                    <a href="/books"
                       class="inline-flex
                              items-center
                              gap-2
                              bg-[#18577f]
                              text-white
                              px-4 py-2
                              rounded-lg
                              text-xs
                              font-semibold
                              hover:bg-[#123f63]
                              transition">
                        View Details
                        <i class="fa-solid
                                  fa-arrow-right
                                  text-[10px]">
                        </i>
                    </a>
                </div>
            </div>
        </div>
        <% }) %>

        <div class="book-card bg-[#123f63]
                    rounded-2xl
                    overflow-hidden
                    shadow-sm">
            <div class="p-6">

                <span class="inline-flex
                             items-center gap-2
                             bg-white/10
                             border border-white/20
                             text-blue-100
                             text-[11px]
                             font-semibold
                             px-3 py-1.5
                             rounded-full">
                    <i class="fa-solid fa-layer-group text-[10px]"></i>
                    Our Collection
                </span>

                <h3 class="section-title
                           text-2xl
                           font-bold
                           text-white
                           mt-5
                           leading-tight">
                    Find your next
                    favourite book.
                </h3>

                <p class="text-blue-100
                          leading-6
                          mt-3 text-sm">
                    Explore our collection and discover
                    books from different categories.
                </p>

                <div class="mt-5 space-y-2.5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8
                                    rounded-lg
                                    bg-white/10
                                    flex items-center
                                    justify-center
                                    text-blue-200">
                            <i class="fa-solid fa-book-open text-xs"></i>
                        </div>
                        <p class="text-blue-100 text-xs"> Stories for every mood
                        </p>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8
                                    rounded-lg
                                    bg-white/10
                                    flex items-center
                                    justify-center
                                    text-blue-200">
                            <i class="fa-solid fa-lightbulb text-xs"></i>
                        </div>
                        <p class="text-blue-100 text-xs">Books that inspire new ideas
                        </p>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8
                                    rounded-lg
                                    bg-white/10
                                    flex items-center
                                    justify-center
                                    text-blue-200">
                            <i class="fa-solid fa-compass text-xs"></i>
                        </div>
                        <p class="text-blue-100 text-xs"> Explore different categories </p>
                    </div>
                </div>

                <div class="border-t
                            border-white/15
                            mt-5 pt-4">

                    <p class="text-blue-200
                              text-[10px]
                              uppercase
                              tracking-[2px]">
                        Popular categories
                    </p>

                    <div class="flex flex-wrap
                                gap-2 mt-2">

                        <span class="px-2.5 py-1
                                     rounded-md
                                     bg-white/10
                                     text-white
                                     text-[11px]">
                            Fantasy
                        </span>

                        <span class="px-2.5 py-1
                                     rounded-md
                                     bg-white/10
                                     text-white
                                     text-[11px]">
                            Fiction
                        </span>

                        <span class="px-2.5 py-1
                                     rounded-md
                                     bg-white/10
                                     text-white
                                     text-[11px]">
                            Biography
                        </span>
                    </div>
                </div>

                <a href="/books"
                   class="w-full
                          mt-4
                          inline-flex
                          justify-center
                          items-center
                          gap-2
                          bg-white
                          text-[#123f63]
                          rounded-lg
                          py-2.5
                          text-sm
                          font-semibold
                          hover:bg-blue-50
                          transition">
                    Explore Books
                    <i class="fa-solid
                              fa-arrow-right
                              text-xs">
                    </i>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="max-w-6xl mx-auto px-5 pb-16">
    <div class="bg-white rounded-3xl
                p-8 md:p-12
                shadow-sm
                flex flex-col
                md:flex-row
                items-center gap-10">

        <div class="w-full md:w-2/5">
            <div class="rounded-2xl
                        bg-gradient-to-br
                        from-[#123f63]
                        to-[#398bd5]
                        p-10 text-center
                        text-white">

                <p class="uppercase
                          tracking-[4px]
                          text-sm
                          text-blue-100">
                    About Us
                </p>

                <i class="fa-solid fa-book-open
                          text-7xl mt-7"></i>

                <h2 class="section-title
                           text-3xl
                           font-bold mt-5">

                    A simple space
                    for readers.
                </h2>
            </div>
        </div>

        <div class="w-full md:w-3/5">
            <p class="text-[#236f9f]
                      font-semibold uppercase
                      tracking-widest text-sm">
                Our bookstore
            </p>

            <h2 class="section-title
                       text-3xl md:text-4xl
                       font-bold
                       text-[#123f63]
                       mt-2">
                Discover something
                worth reading.
            </h2>

            <p class="text-slate-600
                      leading-7 mt-5">
                Our bookstore brings together different
                kinds of books in one simple collection.
                From imaginative stories to books about
                learning and personal growth, there is
                something for different reading interests.
            </p>

            <p class="text-slate-500
                      leading-7 mt-3">
                Take your time, explore the collection
                and find a book that interests you.
            </p>

            <a href="/about"
               class="inline-block mt-6
                      px-6 py-3
                      rounded-xl
                      bg-[#18577f]
                      text-white
                      font-semibold
                      hover:bg-[#123f63]
                      transition">
                Read More 
            </a>
        </div>
    </div>
</section>

<section class="max-w-6xl mx-auto px-5 pb-16">
    <div class="text-center mb-9">
        <p class="text-[#236f9f]
                  font-semibold uppercase
                  tracking-widest text-sm">
            Browse our collection
        </p>

        <h2 class="section-title
                   text-3xl md:text-4xl
                   font-bold
                   text-[#123f63] mt-2">
            Explore Categories
        </h2>
    </div>

    <div class="grid grid-cols-2
                md:grid-cols-4 gap-5">

        <a href="/category/Fantasy"
           class="category-card bg-white
                  rounded-2xl p-7
                  text-center shadow-sm
                  border border-blue-50">

            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">

                <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>

            <h3 class="text-lg font-bold
                       text-[#123f63] mt-4">
                Fantasy
            </h3>

            <p class="text-sm text-slate-400 mt-2">
                Magical worlds and adventures
            </p>
        </a>

        <a href="/category/Self Learning"
           class="category-card bg-white
                  rounded-2xl p-7
                  text-center shadow-sm
                  border border-blue-50">

            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <h3 class="text-lg font-bold
                       text-[#123f63] mt-4">Self Learning </h3>
            <p class="text-sm text-slate-400 mt-2">Ideas for learning and growth</p>
        </a>

        <a href="/category/Fiction"
           class="category-card bg-white
                  rounded-2xl p-7
                  text-center shadow-sm
                  border border-blue-50">

            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">
                <i class="fa-solid fa-pen-nib"></i>
            </div>

            <h3 class="text-lg font-bold
                       text-[#123f63] mt-4">
                Fiction
            </h3>

            <p class="text-sm text-slate-400 mt-2">
                Stories and imagination
            </p>
        </a>



        <a href="/category/Biography"
           class="category-card bg-white
                  rounded-2xl p-7
                  text-center shadow-sm
                  border border-blue-50">

            <div class="w-12 h-12
                        mx-auto rounded-full
                        bg-blue-50
                        flex items-center
                        justify-center
                        text-[#236f9f]">
                <i class="fa-solid fa-user"></i>
            </div>


            <h3 class="text-lg font-bold
                       text-[#123f63] mt-4">
                Biography
            </h3>


            <p class="text-sm text-slate-400 mt-2">
                Real lives and journeys
            </p>
        </a>
    </div>
</section>


<section class="max-w-6xl mx-auto px-5 pb-16">
    <div class="hero rounded-3xl
                p-10 md:p-14
                text-center text-white">
        <p class="uppercase
                  tracking-[3px]
                  text-sm text-blue-200">
            Your next book is waiting
        </p>

        <h2 class="section-title
                   text-3xl md:text-4xl
                   font-bold mt-3">
            Take a look at our collection.
        </h2>

        <p class="text-blue-100
                  max-w-xl mx-auto
                  mt-4 leading-7">
            Explore different categories and discover
            a book that you would love to read.
        </p>


        <a href="/books"
           class="inline-flex
                  items-center
                  gap-2
                  mt-7
                  bg-white
                  text-[#123f63]
                  px-7 py-3
                  rounded-xl
                  font-semibold
                  hover:bg-blue-50
                  transition">
            Explore Books
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</section>
<%- include('includes/footer.ejs') %>
</body>
</html>